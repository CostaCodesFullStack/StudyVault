# Use a MESMA senha em POSTGRES_PASSWORD e em DATABASE_URL.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://studyvault:TROQUE_PELA_SENHA@localhost:5432/studyvault
# Gere com: openssl rand -base64 32  (mínimo 32 caracteres; a app não inicia sessões sem ele)
AUTH_SECRET=
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
# Somente para `npm run db:seed` (opcional, desenvolvimento)
SEED_PASSWORD=
