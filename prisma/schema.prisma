generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentCategory {
  UNIVERSITY
  CURSOR
  DEVELOPMENT
  OTHER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  semesters    Semester[]
  documents    Document[]
  progress     ReadingProgress[]
  bookmarks    Bookmark[]
  notes        Note[]
}

model Semester {
  id        String   @id @default(cuid())
  userId    String
  name      String
  number    Int
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects  Subject[]
  @@unique([userId, slug])
}

model Subject {
  id          String   @id @default(cuid())
  semesterId  String
  name        String
  slug        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  semester    Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  units       Unit[]
  @@unique([semesterId, slug])
}

model Unit {
  id          String   @id @default(cuid())
  subjectId   String
  number      Int
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  documents   Document[]
  @@unique([subjectId, number])
}

model Lesson {
  id          String   @id @default(cuid())
  unitId      String
  number      Int
  code        String
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  documents   Document[]
  @@unique([unitId, number])
}

model Document {
  id        String           @id @default(cuid())
  userId    String
  unitId    String?
  lessonId  String?
  category  DocumentCategory
  subcategory String?
  title     String
  fileName  String
  storageKey String          @unique
  mimeType  String
  fileSize  Int
  pageCount Int?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit      Unit?            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  lesson    Lesson?          @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  progress  ReadingProgress[]
  bookmarks Bookmark[]
  notes     Note[]
  @@index([userId, category])
  @@index([unitId])
  @@index([lessonId])
}

model ReadingProgress {
  id           String   @id @default(cuid())
  userId       String
  documentId   String
  currentPage  Int
  totalPages   Int
  percentage   Float
  lastOpenedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  @@unique([userId, documentId])
  @@index([userId, lastOpenedAt])
}

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  documentId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  @@unique([userId, documentId])
}

model Note {
  id         String   @id @default(cuid())
  userId     String
  documentId String
  page       Int
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  @@index([documentId, page])
}

/// Arquivos cujo registro já foi apagado e que aguardam remoção física (retry via `npm run storage:cleanup`).
model PendingFileDeletion {
  id         String   @id @default(cuid())
  storageKey String   @unique
  attempts   Int      @default(0)
  lastError  String?
  createdAt  DateTime @default(now())
}
